# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

# Build React Native from source rather than using the 0.86 prebuilt core.
#
# The prebuilt React-Core-prebuilt / ReactNativeDependencies xcframeworks are
# release-built, and `Sealable`, `getDebugName()` and `getDebugValue()` are debug-only
# renderer symbols (RN_DEBUG_STRING_CONVERTIBLE). A Debug build compiles every
# third-party Fabric component *with* references to them and then has nothing to link
# against, so the whole app fails with a wall of `Undefined symbol:
# facebook::react::...` naming GestureHandler, Reanimated and the WebView — none of
# which is the actual problem.
#
# Set here rather than left as an env var on the command line: a `pod install` that
# forgets it silently reinstates a Debug build that cannot link, and the error gives no
# hint about why. Release builds work either way; this costs a long first compile and
# is incremental after that.
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '0'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'PoppysSpike' do
  config = use_native_modules!

  # Sign in with Google pulls in AppCheckCore, which is Swift and depends on two pods
  # that ship without module maps. Static-linked Swift cannot import those, and pod
  # install refuses with "cannot yet be integrated as static libraries".
  #
  # Named individually rather than turning on use_modular_headers! for everything:
  # the global switch changes how every pod in the project is built, including React
  # Native's own, and this is a two-pod problem.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
