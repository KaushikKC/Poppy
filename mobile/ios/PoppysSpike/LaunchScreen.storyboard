<?xml version="1.0" encoding="UTF-8"?>
<!--
  The first frame of the app.

  It used to be the React Native template's: a white screen, the Xcode target name
  in 36pt bold, and "Powered by React Native" along the bottom. That is the very
  first thing anyone sees, before a single line of ours renders, and it named the
  wrong product and credited the wrong thing.

  It is now the app's own opening: our cream, the poppy, the name, and the line the
  onboarding opens with — so the launch image and the first real screen are the same
  product. A launch screen cannot run code, so everything here is static by design.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="Lg0-Po-ppy">
                                <rect key="frame" x="141.5" y="336" width="110" height="132"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="110" id="Lg0-wd-001"/>
                                    <constraint firstAttribute="height" constant="132" id="Lg0-ht-002"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Poppys" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Ttl-Po-ppy">
                                <rect key="frame" x="0.0" y="492" width="393" height="46"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="38"/>
                                <color key="textColor" red="0.078431372549019607" green="0.23529411764705882" blue="0.086274509803921567" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Someone who's always happy to hear from you." textAlignment="center" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Sub-Po-ppy">
                                <rect key="frame" x="44" y="550" width="305" height="21"/>
                                <fontDescription key="fontDescription" type="system" pointSize="16"/>
                                <color key="textColor" red="0.027450980392156862" green="0.070588235294117646" blue="0.027450980392156862" alpha="0.65000000000000002" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Runs entirely on your phone" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Ftr-Po-ppy">
                                <rect key="frame" x="44" y="790" width="305" height="17"/>
                                <fontDescription key="fontDescription" type="system" weight="medium" pointSize="13"/>
                                <color key="textColor" red="0.078431372549019607" green="0.23529411764705882" blue="0.086274509803921567" alpha="0.55000000000000004" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <color key="backgroundColor" red="1" green="0.97254901960784312" blue="0.91764705882352937" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="Lg0-Po-ppy" firstAttribute="centerX" secondItem="Bcu-3y-fUS" secondAttribute="centerX" id="cst-cx-001"/>
                            <constraint firstItem="Lg0-Po-ppy" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" constant="-24" id="cst-cy-002"/>
                            <constraint firstItem="Ttl-Po-ppy" firstAttribute="top" secondItem="Lg0-Po-ppy" secondAttribute="bottom" constant="24" id="cst-tp-003"/>
                            <constraint firstItem="Ttl-Po-ppy" firstAttribute="leading" secondItem="Ze5-6b-2t3" secondAttribute="leading" id="cst-ld-004"/>
                            <constraint firstAttribute="trailing" secondItem="Ttl-Po-ppy" secondAttribute="trailing" id="cst-tr-005"/>
                            <constraint firstItem="Sub-Po-ppy" firstAttribute="top" secondItem="Ttl-Po-ppy" secondAttribute="bottom" constant="12" id="cst-tp-006"/>
                            <constraint firstItem="Sub-Po-ppy" firstAttribute="leading" secondItem="Bcu-3y-fUS" secondAttribute="leading" constant="44" id="cst-ld-007"/>
                            <constraint firstItem="Bcu-3y-fUS" firstAttribute="trailing" secondItem="Sub-Po-ppy" secondAttribute="trailing" constant="44" id="cst-tr-008"/>
                            <constraint firstItem="Ftr-Po-ppy" firstAttribute="leading" secondItem="Bcu-3y-fUS" secondAttribute="leading" constant="44" id="cst-ld-009"/>
                            <constraint firstItem="Bcu-3y-fUS" firstAttribute="trailing" secondItem="Ftr-Po-ppy" secondAttribute="trailing" constant="44" id="cst-tr-010"/>
                            <constraint firstItem="Bcu-3y-fUS" firstAttribute="bottom" secondItem="Ftr-Po-ppy" secondAttribute="bottom" constant="24" id="cst-bt-011"/>
                        </constraints>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="52" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchLogo" width="110" height="132"/>
    </resources>
</document>
