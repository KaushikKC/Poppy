# Copy to android/keystore.properties and fill in. That file is gitignored.
#
# Create the keystore first, from the android/ directory:
#
#   keytool -genkeypair -v -keystore poppys-release.keystore \
#     -alias poppys -keyalg RSA -keysize 2048 -validity 10000
#
# Back the .keystore file up somewhere you will still have it in five years, and keep
# the passwords with it. Play will not accept an update signed with a different key,
# so losing this means never updating the app again under the same listing.
storeFile=poppys-release.keystore
storePassword=
keyAlias=poppys
keyPassword=
