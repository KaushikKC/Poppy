# Copy to android/keystore.properties (copy, not move — keep this example) and fill in.
# keystore.properties is gitignored and must stay that way.
#
# Create the keystore in *this* directory, android/. storeFile is resolved from here,
# beside this file, not from android/app/:
#
#   keytool -genkeypair -v -keystore poppys-release.keystore \
#     -alias poppys -keyalg RSA -keysize 2048 -validity 10000
#
# Back the .keystore file up somewhere you will still have it in five years, and keep
# the passwords with it. Play will not accept an update signed with a different key, so
# losing this means never updating the app again under the same listing.
storeFile=poppys-release.keystore
storePassword=
keyAlias=poppys
keyPassword=
